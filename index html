<!-- МИНИСТЕРСТВО ОБРАЗОВАНИЯ — ЛИСТ А                     -->
<!-- ====================================================== -->
<section class="page" id="page-1a">
  <div class="sheet m1">
    <span class="sheet-label">Министерство образования · Лист 1 из 2</span>
    <div class="sheet-head">
      <div class="badge">⚙️</div>
      <h1>Министерство образования</h1>
    </div>

    <p class="direction">
      <span class="label">🎭 Направление деятельности:</span>Здесь мы будем обсуждать всё, что связано с учёбой: домашние задания, расписание, новые предметы и интересные образовательные проекты.
    </p>

    <h2><span class="num">1</span> Куратор-пилот министерства</h2>
    <div class="curator">
      <div class="field">
        <label>ФИО куратора</label>
        <input type="text" placeholder="Введите ФИО" autocomplete="off">
