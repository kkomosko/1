<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Выборы в Министерства школы</title>
<style>
  :root{
    --m1:#2563eb;
    --m2:#db2777;
    --m3:#d97706;
    --ink:#1f2937;
    --muted:#6b7280;
    --line:#d1d5db;
    --focus:#eef2ff;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;margin:0;}

  html{
    scroll-snap-type:y mandatory;
    scroll-behavior:smooth;
  }

  /* ============ ФОН «АЭРОПЛАН» ============ */
  body{
    font-family:"Segoe UI",Roboto,Arial,sans-serif;
    color:var(--ink);
    line-height:1.45;
    background:#ffffff;
    background-attachment:fixed;
    background-size:cover;
    background-repeat:no-repeat;
    background-image:
      radial-gradient(circle at 8% 18%, rgba(150,190,235,.50) 0%, rgba(150,190,235,0) 26%),
      radial-gradient(circle at 18% 38%, rgba(120,160,215,.45) 0%, rgba(120,160,215,0) 24%),
      radial-gradient(circle at 30% 12%, rgba(180,215,240,.55) 0%, rgba(180,215,240,0) 24%),
      radial-gradient(circle at 42% 28%, rgba(140,195,235,.55) 0%, rgba(140,195,235,0) 22%),
      radial-gradient(circle at 55% 15%, rgba(190,220,240,.55) 0%, rgba(190,220,240,0) 22%),
      radial-gradient(circle at 68% 35%, rgba(175,210,235,.45) 0%, rgba(175,210,235,0) 22%),
      radial-gradient(circle at 85% 28%, rgba(225,200,220,.30) 0%, rgba(225,200,220,0) 24%),
      radial-gradient(circle at 8% 60%, rgba(200,195,230,.35) 0%, rgba(200,195,230,0) 22%),
      radial-gradient(circle at 25% 80%, rgba(240,220,210,.35) 0%, rgba(240,220,210,0) 22%),
      radial-gradient(circle at 12% 82%, #f8d8e2 0 36px, transparent 37px),
      radial-gradient(circle at 22% 88%, #fce4d4 0 30px, transparent 31px),
      radial-gradient(circle at 6% 88%,  #cdd5ec 0 22px, transparent 23px),
      radial-gradient(circle at 55% 78%, #f8b8d0 0 26px, transparent 27px),
      radial-gradient(circle at 62% 85%, #fce4d4 0 40px, transparent 41px),
      radial-gradient(circle at 92% 72%, #f5c9dc 0 22px, transparent 23px),
      radial-gradient(circle at 78% 80%, #bfe1ee 0 18px, transparent 19px),
      radial-gradient(circle at 96% 88%, #f7dbe2 0 44px, transparent 45px),
      radial-gradient(circle at 88% 90%, #ece0f0 0 20px, transparent 21px),
      radial-gradient(circle at 42% 90%, #d9e6f5 0 16px, transparent 17px),
      radial-gradient(circle at 46% 45%, #cfe5f2 0 34px, transparent 35px),
      radial-gradient(circle at 72% 45%, #f0d9e8 0 28px, transparent 29px),
      radial-gradient(circle at 96% 22%, #e8d3e0 0 32px, transparent 33px),
      radial-gradient(circle at 30% 55%, #ecd4e4 0 18px, transparent 19px),
      radial-gradient(circle at 50% 60%, #c4dcee 0 12px, transparent 13px),
      radial-gradient(circle at 82% 12%, #f1d4dc 0 16px, transparent 17px),
      radial-gradient(circle at 14% 8%,  #c9dcf0 0 18px, transparent 19px);
    overflow-x:hidden;
  }

  body::before{
    content:"";
    position:fixed;inset:0;
    pointer-events:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='500' height='500'><g fill='%23a9c3e0' opacity='.55'><circle cx='12' cy='30' r='4'/><circle cx='60' cy='14' r='3'/><circle cx='110' cy='65' r='5'/><circle cx='170' cy='28' r='3'/><circle cx='220' cy='80' r='4'/><circle cx='280' cy='45' r='5'/><circle cx='340' cy='18' r='3'/><circle cx='400' cy='70' r='4'/><circle cx='460' cy='30' r='3'/><circle cx='30' cy='130' r='3'/><circle cx='85' cy='180' r='4'/><circle cx='145' cy='155' r='5'/><circle cx='205' cy='210' r='3'/><circle cx='265' cy='170' r='4'/><circle cx='320' cy='200' r='5'/><circle cx='380' cy='145' r='3'/><circle cx='440' cy='195' r='4'/><circle cx='50' cy='290' r='4'/><circle cx='120' cy='320' r='3'/><circle cx='185' cy='275' r='5'/><circle cx='250' cy='335' r='3'/><circle cx='310' cy='300' r='4'/><circle cx='375' cy='345' r='3'/><circle cx='440' cy='290' r='4'/><circle cx='25' cy='410' r='3'/><circle cx='95' cy='440' r='5'/><circle cx='165' cy='400' r='3'/><circle cx='235' cy='450' r='4'/><circle cx='305' cy='415' r='3'/><circle cx='375' cy='460' r='4'/><circle cx='445' cy='425' r='3'/></g><g fill='%23e9c8d6' opacity='.55'><circle cx='45' cy='95' r='3'/><circle cx='135' cy='115' r='4'/><circle cx='250' cy='130' r='3'/><circle cx='360' cy='105' r='4'/><circle cx='450' cy='145' r='3'/><circle cx='80' cy='250' r='4'/><circle cx='200' cy='270' r='3'/><circle cx='330' cy='255' r='4'/><circle cx='425' cy='245' r='3'/><circle cx='20' cy='375' r='3'/><circle cx='145' cy='390' r='4'/><circle cx='270' cy='400' r='3'/><circle cx='395' cy='385' r='4'/></g><g fill='%23f4ddc7' opacity='.55'><circle cx='95' cy='55' r='4'/><circle cx='195' cy='40' r='3'/><circle cx='310' cy='75' r='4'/><circle cx='410' cy='55' r='3'/><circle cx='55' cy='225' r='3'/><circle cx='170' cy='205' r='4'/><circle cx='285' cy='230' r='3'/><circle cx='395' cy='210' r='4'/><circle cx='110' cy='325' r='3'/><circle cx='230' cy='320' r='4'/><circle cx='350' cy='345' r='3'/><circle cx='450' cy='330' r='4'/></g></svg>");
    opacity:.85;
    mix-blend-mode:multiply;
    z-index:0;
  }

  body::after{
    content:"";
    position:fixed;inset:0;
    pointer-events:none;
    background:
      radial-gradient(circle at 10% 25%, rgba(255,255,255,.85) 0%, rgba(255,255,255,0) 20%),
      radial-gradient(circle at 40% 20%, rgba(255,255,255,.90) 0%, rgba(255,255,255,0) 18%),
      radial-gradient(circle at 70% 30%, rgba(255,255,255,.85) 0%, rgba(255,255,255,0) 18%),
      radial-gradient(circle at 25% 55%, rgba(255,255,255,.75) 0%, rgba(255,255,255,0) 16%),
      radial-gradient(circle at 60% 50%, rgba(255,255,255,.85) 0%, rgba(255,255,255,0) 18%),
      radial-gradient(circle at 88% 60%, rgba(255,255,255,.80) 0%, rgba(255,255,255,0) 16%),
      radial-gradient(circle at 15% 80%, rgba(255,255,255,.85) 0%, rgba(255,255,255,0) 16%),
      radial-gradient(circle at 50% 85%, rgba(255,255,255,.80) 0%, rgba(255,255,255,0) 16%),
      radial-gradient(circle at 80% 90%, rgba(255,255,255,.85) 0%, rgba(255,255,255,0) 16%);
    z-index:0;
  }

  /* ============ ЛОГОТИП И ДЕВИЗ ============ */
  .brand-block{
    position:fixed;
    top:0;left:0;right:0;
    z-index:50;
    pointer-events:none;
    transition:opacity .35s ease, visibility .35s ease;
    opacity:1;visibility:visible;
  }
  .brand-block.hidden{
    opacity:0;
    visibility:hidden;
  }
  .brand{
    position:absolute;
    top:24px;left:40px;
    display:flex;flex-direction:column;align-items:center;
    color:#3b4a63;font-weight:600;letter-spacing:1.5px;font-size:13px;
    user-select:none;
  }
  .brand svg{display:block;margin-bottom:4px;}
  .slogan{
    position:absolute;
    top:44px;right:56px;
    color:#6b7a90;font-weight:400;
    letter-spacing:8px;font-size:22px;
    user-select:none;text-transform:uppercase;
    font-family:"Georgia","Times New Roman",serif;
    text-shadow:0 1px 3px rgba(255,255,255,.9);
  }

  /* ============ ОБЩИЕ СТРАНИЦЫ ============ */
  .page{
    min-height:100vh;
    scroll-snap-align:start;
    scroll-snap-stop:always;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-start;
    padding:80px 16px 40px;
    position:relative;
    z-index:1;
  }
  .page.cover{
    justify-content:center;
    text-align:center;
    padding-top:120px;
  }
  .cover h1{
    color:#3b4a63;font-size:32px;letter-spacing:1px;
    margin:0 0 40px;
  }
  .cover .hint{
    color:#8895a8;font-size:14px;margin-top:20px;
    animation:bounce 1.8s infinite;
  }
  @keyframes bounce{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(6px);}
  }

  /* ============ ТУЛБАР ============ */
  .toolbar{
    position:relative;
    z-index:4;
    max-width:900px;
    margin:0 auto 24px;
    display:flex;flex-wrap:wrap;gap:10px;justify-content:center;
  }
  .toolbar button{
    border:none;background:rgba(17,24,39,.9);color:#fff;
    padding:10px 18px;border-radius:8px;font-size:15px;cursor:pointer;
    transition:.2s;backdrop-filter:blur(4px);
  }
  .toolbar button:hover{background:#374151;}

  /* ============ ЛИСТЫ ============ */
  .sheet{
    width:100%;
    max-width:900px;
    background:rgba(255,255,255,.88);
    backdrop-filter:blur(4px);
    padding:32px 36px 40px;
    border-radius:14px;
    box-shadow:0 4px 24px rgba(70,100,150,.15);
    border-top:8px solid var(--accent,#2563eb);
  }
  .sheet-head{display:flex;align-items:center;gap:14px;margin-bottom:6px;}

  .badge{
    flex:0 0 auto;
    width:52px;height:52px;
    border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:24px;
    background:var(--accent);
    color:#fff;
  }

  .sheet h1{font-size:23px;margin:0;color:var(--accent);letter-spacing:.3px;}
  .sheet h2{
    font-size:17px;margin:26px 0 10px;padding-bottom:6px;
    border-bottom:2px solid var(--accent);color:var(--ink);
    display:flex;align-items:center;gap:8px;
  }
  .sheet h2 .num{
    background:var(--accent);color:#fff;font-size:13px;
    width:22px;height:22px;border-radius:50%;
    display:inline-flex;align-items:center;justify-content:center;
  }

  /* ============ НАПРАВЛЕНИЕ ДЕЯТЕЛЬНОСТИ ============ */
  .direction{
    margin:6px 0 22px;
    color:var(--ink);
    font-size:16px;
    font-weight:600;
    line-height:1.5;
  }
  .direction .label{
    font-weight:800;
    color:var(--accent);
    margin-right:5px;
    letter-spacing:.2px;
  }

  /* ============ ПЛАШКА ============ */
  .sheet-label{
    display:inline-block;
    font-size:12px;
    font-weight:700;
    letter-spacing:1px;
    text-transform:uppercase;
    color:#fff;
    background:var(--accent);
    padding:3px 10px;
    border-radius:12px;
    margin-bottom:12px;
  }

  /* ============ ТАБЛИЦЫ ============ */
  table{width:100%;border-collapse:collapse;font-size:14px;}
  th,td{border:1px solid var(--line);padding:0;text-align:left;vertical-align:middle;}
  th{background:#f9fafb;font-weight:600;font-size:13px;color:#374151;padding:7px 8px;}
  td{padding:0;}
  td input[type="text"]{
    width:100%;border:none;background:transparent;
    font-size:14px;font-family:inherit;color:var(--ink);
    padding:9px 8px;outline:none;display:block;
    transition:background .15s;
  }
  td input:focus{
    background:var(--focus);
    box-shadow:inset 0 0 0 2px var(--accent);
    border-radius:4px;
  }
  .cell-num{width:34px;text-align:center;color:var(--muted);font-size:13px;padding:7px 8px;}
  .cell-class{width:80px;}

  /* ============ КУРАТОР ============ */
  .curator{margin-bottom:4px;}
  .curator .field{display:flex;flex-direction:column;gap:4px;}
  .curator label{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;}
  .curator input{
    border:1px solid var(--line);border-radius:6px;
    padding:10px 12px;font-size:14px;font-family:inherit;
    background:#fff;transition:.15s;
  }
  .curator input:focus{
    outline:none;
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(37,99,235,.15);
    background:var(--focus);
  }

  /* ============ ЗАДАЧИ ============ */
  .task-block{
    border:1px solid var(--line);
    border-radius:10px;
    padding:12px 14px;
    margin-bottom:10px;
    background:#fff;
    transition:.15s;
  }
  .task-block:focus-within{
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(37,99,235,.12);
  }
  .task-row{
    display:flex;
    align-items:flex-start;
    gap:10px;
    font-size:14.5px;
    font-weight:600;
    color:#374151;
    margin-bottom:8px;
  }
  .task-row input[type=checkbox]{
    width:18px;height:18px;margin-top:2px;
    accent-color:var(--accent);flex:0 0 auto;cursor:pointer;
  }
  .task-row label{
    flex:1;cursor:pointer;line-height:1.4;
  }
  .task-idea{
    display:flex;align-items:flex-start;gap:8px;
  }
  .task-idea .icon{
    flex:0 0 auto;font-size:15px;color:var(--accent);
    line-height:1.6;user-select:none;
  }
  .task-idea textarea{
    flex:1;min-height:44px;
    border:1px dashed var(--line);border-radius:8px;
    padding:8px 10px;font-family:inherit;font-size:14px;
    line-height:1.4;color:var(--ink);background:#fcfdff;
    resize:vertical;outline:none;transition:.15s;
  }
  .task-idea textarea:focus{
    border:1px solid var(--accent);border-style:solid;
    background:var(--focus);box-shadow:0 0 0 3px rgba(37,99,235,.12);
  }
  .task-idea textarea::placeholder{color:#a3adbd;font-style:italic;}

  /* ============ ДОП. ЗАДАЧИ ============ */
  .extra-task{
    border:1px solid var(--line);border-radius:10px;
    padding:12px 14px;margin-bottom:10px;background:#fff;
    transition:.15s;
  }
  .extra-task:focus-within{
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(37,99,235,.12);
  }
  .extra-task .task-row{margin-bottom:8px;}
  .extra-task textarea{
    width:100%;min-height:70px;
    border:1px dashed var(--line);border-radius:8px;
    padding:8px 10px;font-family:inherit;font-size:14px;
    line-height:1.4;color:var(--ink);background:#fcfdff;
    resize:vertical;outline:none;transition:.15s;
  }
  .extra-task textarea:focus{
    border:1px solid var(--accent);border-style:solid;
    background:var(--focus);box-shadow:0 0 0 3px rgba(37,99,235,.12);
  }
  .extra-task textarea::placeholder{color:#a3adbd;font-style:italic;}

  /* ============ ПРОЧИЕ СТРОКИ ============ */
  .lines{margin-top:14px;font-size:14.5px;}
  .lines .row{display:flex;align-items:baseline;gap:10px;margin:10px 0;}
  .lines .row span{flex:0 0 auto;font-weight:600;color:#374151;}
  .lines .row input{
    flex:1;border:none;border-bottom:1.5px solid var(--line);
    background:transparent;font-family:inherit;font-size:14px;
    padding:6px 4px;outline:none;transition:.15s;
  }
  .lines .row input:focus{
    border-color:var(--accent);background:var(--focus);
    border-radius:4px 4px 0 0;
  }

  .team{list-style:none;padding:0;margin:0;font-size:14.5px;}
  .team li{display:flex;align-items:baseline;gap:10px;margin:10px 0;}
  .team li b{flex:0 0 180px;color:#374151;font-weight:600;}
  .team li input{
    flex:1;border:none;border-bottom:1.5px solid var(--line);
    background:transparent;font-family:inherit;font-size:14px;
    padding:6px 4px;outline:none;transition:.15s;
  }
  .team li input:focus{
    border-color:var(--accent);background:var(--focus);
    border-radius:4px 4px 0 0;
  }

  .footer-note{
    margin-top:26px;padding-top:12px;
    border-top:1px solid var(--line);
    font-size:12px;color:var(--muted);
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;
  }
  .footer-note input{
    border:none;border-bottom:1px dotted var(--line);
    background:transparent;font-family:inherit;font-size:12px;
    padding:2px 4px;outline:none;min-width:120px;
  }
  .footer-note input:focus{background:var(--focus);border-bottom-color:var(--accent);}

  /* ============ ЦВЕТА МИНИСТЕРСТВ ============ */
  .m1{--accent:var(--m1);}
  .m2{--accent:var(--m2);}
  .m3{--accent:var(--m3);}

  /* ============ ИНДИКАТОР СТРАНИЦ ============ */
  .page-dots{
    position:fixed;
    right:18px;top:50%;
    transform:translateY(-50%);
    z-index:60;
    display:flex;flex-direction:column;gap:8px;
  }
  .page-dots a{
    display:block;width:9px;height:9px;border-radius:50%;
    background:rgba(120,140,170,.35);
    border:1px solid rgba(120,140,170,.5);
    transition:.25s;
  }
  .page-dots a:hover{transform:scale(1.3);}
  .page-dots a.active{
    background:#3b4a63;border-color:#3b4a63;
    transform:scale(1.35);
  }

  /* ============ ПЕЧАТЬ ============ */
  @media print{
    html{scroll-snap-type:none;}
    body{background:#fff !important;}
    body::before, body::after{display:none;}
    .brand-block,.toolbar,.page-dots,.cover,.hint{display:none !important;}
    .page{
      min-height:auto;padding:0;scroll-snap-align:none;
      page-break-after:always;
    }
    .page:last-of-type{page-break-after:auto;}
    .sheet{
      box-shadow:none;border-radius:0;max-width:100%;
      background:#fff;backdrop-filter:none;
      page-break-inside:avoid;
    }
    .task-block,.extra-task{
      border:1px solid #d1d5db !important;
      box-shadow:none !important;
    }
    td input, .curator input,
    .lines .row input, .team li input,
    .task-idea textarea, .extra-task textarea{
      background:transparent !important;
      box-shadow:none !important;
    }
    @page{size:A4;margin:10mm;}
  }
</style>
</head>
