<script>
  // ===== Скрытие логотипа и слогана при уходе с титульной =====
  const brandBlock = document.getElementById('brandBlock');
  const cover = document.getElementById('page-cover');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.target === cover && entry.isIntersecting && entry.intersectionRatio > 0.6) {
        brandBlock.classList.remove('hidden');
      } else if (entry.target === cover) {
        brandBlock.classList.add('hidden');
      }
    });
  }, { threshold: [0, 0.3, 0.6, 0.9] });

  observer.observe(cover);

  // ===== Активная точка в индикаторе =====
  const dots = document.querySelectorAll('.page-dots a');
  const pages = document.querySelectorAll('.page');

  const pageObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
        const id = entry.target.id;
        dots.forEach(d => d.classList.toggle('active', d.dataset.target === id));
      }
    });
  }, { threshold: [0.5, 0.7] });

  pages.forEach(p => pageObserver.observe(p));

  // ===== Автосохранение =====
  const allInputs = document.querySelectorAll(
    'input[type="text"], input[type="checkbox"], textarea'
  );
  allInputs.forEach((el, i) => {
    const key = 'ministers_field_v9_' + i;
    const saved = localStorage.getItem(key);
    if (saved !== null) {
      if (el.type === 'checkbox') el.checked = saved === 'true';
      else el.value = saved;
    }
    const save = () => {
      if (el.type === 'checkbox') localStorage.setItem(key, el.checked);
      else localStorage.setItem(key, el.value);
    };
    el.addEventListener('input', save);
    el.addEventListener('change', save);
  });
</script>

</body>
</html>
